---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import Layout from '../../layouts/BaseLayout.astro';

import Analytics from '@vercel/analytics/astro'


const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---


<Layout title ="Articles" description="不定期更新中">
	<div class="titlebar">
        <h1>Articles</h1>
    </div>
	<div class="timeline">
		{
		posts.map((post) => (					
			<a class="post_card" href={`/blog/${post.id}/`}>
				<div class="post_timestamp">{post.data.pubDate}</div>
				<div class="post_title">{post.data.title}</div>
				<div class="post_description">{post.data.description.replace(/<[^>]*>/g, '')}</div>
								
			</a>
							
		))}
	</div>

</Layout>
